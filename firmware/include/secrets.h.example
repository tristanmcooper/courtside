// Copy this file to secrets.h (gitignored), then fill in your values.
#pragma once

// 1 = connect to WiFi and POST readings to the backend (feeds the live dashboard).
// 0 = bench/serial-only: skips all WiFi code (no WiFi libs compiled in).
#define USE_WIFI 1

#define WIFI_SSID     "your-iphone-hotspot-name"
#define WIFI_PASSWORD "your-hotspot-password"

// Dev: your laptop's LAN IP running the backend, e.g. http://192.168.1.23:8000
//      (phone + laptop + ESP32 must be on the same WiFi)
// Beach: your deployed Render URL, e.g. https://courtside.onrender.com  (https OK)
#define BACKEND_URL   "http://192.168.1.23:8000"

#define NODE_KEY      "set-a-long-random-string"   // must match the backend's NODE_KEY env (blank = no auth)
#define NODE_ID       "court-node-1"
